# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-key-here

# Optional service settings
API_URL=http://localhost:8000
# MLFLOW_TRACKING_URI defaults to a local SQLite DB at data/mlflow.db. SQLite is
# a single file (no server) and, unlike the legacy file store, supports the
# trace-metrics aggregates the MLflow 3.x Traces UI draws. Override to point at a
# shared server (e.g. http://localhost:5000) if you run one.
# MLFLOW_TRACKING_URI=sqlite:///data/mlflow.db
# MLFLOW_EXPERIMENT_NAME=hr-agent

# Tavily for Search Tool
TAVILY_API_KEY=your-key-here

# LLM backend: "gemini" (default) or "ollama" (self-hosted, no Gemini free-tier
# daily request cap). Only affects chat/reasoning — RAG embeddings and answer
# generation stay on Gemini either way.
# LLM_PROVIDER=gemini
# OLLAMA_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=gemma4:e4b

# Vision (NBI Clearance extraction, Component 14): "gemini" (default) or
# "ollama". Independent of LLM_PROVIDER -- see CV_INTEGRATION.md §2.6a.
# VISION_PROVIDER=gemini
# GEMINI_VISION_MODEL=gemini-2.5-flash
# OLLAMA_VISION_MODEL=llama3.2-vision

# HR handoff email (Component 14 follow-on) -- fires once an employee's NBI
# Clearance + Government ID both reach "validated". EMAIL_DRY_RUN defaults to
# true: writes a fully-composed .eml to data/outbox/ instead of sending, so a
# fresh checkout (and tests/CI) never sends real mail without an explicit
# opt-in. Real sends go to a Mailtrap Sandbox inbox (never a real recipient)
# -- this is a proof-of-concept project with no production mailbox.
# https://mailtrap.io/inboxes -> pick/create a Sandbox inbox -> Settings/SMTP
# tab has both the API token and the numeric inbox ID.
# MAILTRAP_API_TOKEN=your-token-here
# MAILTRAP_INBOX_ID=your-inbox-id-here
# EMAIL_DRY_RUN=true
# HR_EMAIL_TO=hrmo@faculty-concierge.test
# HR_EMAIL_FROM=onboarding@faculty-concierge.test
# Attach original document images? Demo/mock instances only -- leave false on
# any deployment handling real (non-mock) documents. See CV_INTEGRATION.md.
# EMAIL_ATTACH_ORIGINALS=false