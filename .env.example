# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-key-here

# Optional service settings
API_URL=http://localhost:8000
# MLFLOW_TRACKING_URI defaults to a local SQLite DB at data/mlflow.db. SQLite is
# a single file (no server) and, unlike the legacy file store, supports the
# trace-metrics aggregates the MLflow 3.x Traces UI draws. Override to point at a
# shared server (e.g. http://localhost:5000) if you run one.
# MLFLOW_TRACKING_URI=sqlite:///data/mlflow.db
# MLFLOW_EXPERIMENT_NAME=hr-agent

# Tavily for Search Tool
TAVILY_API_KEY=your-key-here

# LLM backend: "gemini" (default) or "ollama" (self-hosted, no Gemini free-tier
# daily request cap). Only affects chat/reasoning — RAG embeddings and answer
# generation stay on Gemini either way.
# LLM_PROVIDER=gemini
# OLLAMA_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=gemma4:e4b